{
  "name": "108teaworks-shop",
  "version": "0.1.0",
  "private": true,
  "browserslist": {
    "production": [
      "chrome >= 120",
      "edge >= 120",
      "firefox >= 120",
      "safari >= 17",
      "ios_saf >= 17"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:3030": "next dev -p 3030",
    "receipt-font": "node scripts/download-receipt-font.mjs",
    "test:shipping-json": "node scripts/verify-shipping-json.mjs",
    "orders:migrate-microcms": "node scripts/migrate-orders-to-microcms.mjs",
    "orders:migrate-microcms:dry": "node scripts/migrate-orders-to-microcms.mjs --dry-run",
    "orders:migrate-microcms:export": "node scripts/migrate-orders-to-microcms.mjs --dry-run --export ./data/orders-microcms-export",
    "orders:migrate-microcms:sh": "bash scripts/migrate-orders-to-microcms.sh",
    "orders:post-microcms:curl": "bash scripts/post-microcms-orders-curl.sh ./data/orders-microcms-export",
    "build": "next build",
    "start": "next start",
    "start:prod": "next start",
    "i18n:translate": "ts-node ./scripts/translate-with-deepl.ts",
    "lint": "next lint",
    "images:amerika": "node scripts/optimize-amerika-images.mjs",
    "images:products-webp": "node scripts/optimize-product-webp.mjs"
  },
  "dependencies": {
    "@fontsource/noto-serif-jp": "^5.2.8",
    "@marsidev/react-turnstile": "^1.5.2",
    "@stripe/react-stripe-js": "^5.6.1",
    "@stripe/stripe-js": "^8.9.0",
    "gray-matter": "^4.0.3",
    "next": "^14.2.35",
    "nodemailer": "^8.0.1",
    "noto-serif-jp": "^28.0.0",
    "pdfjs-dist": "^5.3.93",
    "pdfkit": "^0.17.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-pdf": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-html": "^16.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sanitize-html": "^2.17.3",
    "sharp": "^0.33.5",
    "stripe": "^20.4.1"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.11",
    "@types/pdfkit": "^0.17.5",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/sanitize-html": "^2.16.1",
    "autoprefixer": "^10.4.20",
    "critters": "^0.0.23",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5"
  }
}
