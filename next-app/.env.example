# Instagram Graph API（最新投稿を表示する場合）
# 取得手順: https://developers.facebook.com/docs/instagram-platform
# - Facebook アプリ作成 → Instagram Graph API を追加
# - Instagram ビジネス/クリエイターアカウントを Facebook ページに接続
# - 長期トークンと IG User ID を取得し、以下に設定
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# microCMS（お知らせ一覧・詳細・customers）
# 管理画面: https://108teaworks.microcms.io/ → API キーは各 API の「APIキー」から取得
MICROCMS_SERVICE_DOMAIN=108teaworks
MICROCMS_API_KEY=
# customers への書き込み用。未設定時は上記 API キーを使用
MICROCMS_WRITE_API_KEY=

# 注文スナップショット（注文確認メール本文の保存先）。未設定時は .data/order_snapshots を使用。Vercel では永続しないため自前サーバー等で利用
# Docker 内では例: /app/data/orders（compose の volumes に合わせる）
# ホストで node scripts/migrate-orders-to-microcms.mjs を実行するとき、*.json を読むのは「そのマシン上で有効なパス」だけ。
# コンテナ用が /app/... だけのときは、ホストでは data/orders を探すか、--source /mnt/.../next-app/data/orders を付ける。
ORDER_SNAPSHOTS_DIR=

# ---------- メール送信（Brevo SMTP） ----------
# 手順: next-app/docs/BREVO-SETUP.md を参照
# 送信のみ変更。受信（IMAP/POP3）はそのまま。
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# 送信元（Brevo で認証した @108teaworks.com のアドレス）
ORDER_FROM=info@108teaworks.com
INQUERY_FROM=info@108teaworks.com
CLIENT_MAIL_FROM=info@108teaworks.com

# 送信元の表示名（メールクライアントで「藤八茶寮 <info@...>」と表示される）
MAIL_FROM_NAME=藤八茶寮

# 管理者あて（注文・お問い合わせ通知の宛先）
ORDER_ADMIN_TO=info@108teaworks.com
INQUERY_TO=info@108teaworks.com

# 発送完了メール送信（/admin/send-shipping）で使用する認証キー。任意の長い文字列を設定。
ADMIN_SHIPPING_SECRET=

# ---------- B2B 管理画面（/admin/b2b）Basic認証 ----------
# ここには実際のID/パスワードをコミットしないこと（.env.local に設定）
ADMIN_B2B_USER=
ADMIN_B2B_PASS=

# microCMS の b2b スキーマで「明細繰り返し」フィールドのフィールドIDが lines 以外の場合に指定
MICROCMS_B2B_LINES_FIELD_ID=lines
# microCMS の b2b 明細（繰り返し）内で使うカスタムフィールドID（通常は products）
MICROCMS_B2B_LINE_CUSTOM_FIELD_ID=products

# （管理画面側で参照する場合）同じ値を NEXT_PUBLIC_ にも入れる
NEXT_PUBLIC_B2B_LINE_CUSTOM_FIELD_ID=products

# microCMS 側で taxMode/status を「複数選択」にしている場合は true
MICROCMS_B2B_TAXMODE_IS_ARRAY=
MICROCMS_B2B_STATUS_IS_ARRAY=

# microCMS b2b フィールドIDが標準（status/sentAt/...）から違う場合に指定
MICROCMS_B2B_STATUS_FIELD_ID=status
MICROCMS_B2B_SENTAT_FIELD_ID=sentAt
MICROCMS_B2B_EXPIRESAT_FIELD_ID=expiresAt
MICROCMS_B2B_OPENEDAT_FIELD_ID=openedAt
MICROCMS_B2B_PAIDAT_FIELD_ID=paidAt
MICROCMS_B2B_STRIPE_PI_FIELD_ID=stripePaymentIntentId
MICROCMS_B2B_TOKENHASH_FIELD_ID=tokenHash

# B2B公開ページ（/b2b/[token]）で tokenHash から検索するため、tokenHash フィールドを作って運用する
# NEXT_PUBLIC_SITE_URL は本番URLに合わせて設定（リンク生成で使用）

# ---------- Google Analytics 4 / Google 広告 / Search Console ----------
# GA4: 管理画面 → 管理 → データストリーム → 測定 ID（G-XXXXXXXXXX）
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-NJTRC8EE0F
# Google 広告（gtag の AW-…）。未設定時はコード既定で AW-17844204061
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-17844204061
# GSC: 検索コンソール「所有権の確認」で HTML タグ方式を選んだときの content の値
NEXT_PUBLIC_GSC_VERIFICATION=

# Meta（Facebook）ピクセル。未設定時は 4106662349587657。無効化する場合は空文字。
NEXT_PUBLIC_META_PIXEL_ID=
# Meta Conversions API アクセストークン（サーバーサイドのみ）
# 取得: Meta Events Manager → データソース → ピクセル → 設定 → Conversions API → アクセストークンを生成
META_CAPI_ACCESS_TOKEN=

# Microsoft Clarity: clarity.microsoft.com → プロジェクト作成後の ID（10文字前後）
NEXT_PUBLIC_CLARITY_ID=
